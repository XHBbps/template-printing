# ==== Database ====
POSTGRES_USER=postgres
POSTGRES_PASSWORD= # 强随机密码
POSTGRES_DB=template_printing

# ==== Lark / 飞书 SSO ====
LARK_SSO_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_SSO_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxx
LARK_SSO_REDIRECT_URI=https://your-domain.com/api/auth/lark/callback
LARK_API_BASE=https://open.feishu.cn

# 初始管理员的 lark user_id 列表（逗号分隔）
INITIAL_ADMIN_LARK_USER_IDS=

# ==== JWT ====
# 用 openssl rand -hex 32 生成
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ==== Storage ====
STORAGE_ROOT=/storage

# ==== Deploy meta ====
TAG=latest
REGISTRY=ghcr.io/your-org

# ==== Environment ====
NODE_ENV=production
