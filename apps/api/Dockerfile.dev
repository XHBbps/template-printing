FROM node:20-alpine
# api 不渲染，无需 puppeteer 的 Chromium（全 workspace install 会拉它）；跳过下载，install 快得多
ENV PUPPETEER_SKIP_DOWNLOAD=true
# openssl: required by Prisma to detect libssl version and pick the right query engine.
# libc6-compat: occasionally needed for native modules under Alpine musl.
RUN apk add --no-cache openssl libc6-compat python3 make g++ vips-dev
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /workspace
# Source mounted as volume — install handled by host or first start
CMD sh -c "pnpm install && pnpm --filter @template-printing/api db:generate && pnpm --filter @template-printing/api dev"
