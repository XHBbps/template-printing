{
  "name": "@template-printing/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./template": {
      "types": "./dist/template.d.ts",
      "default": "./dist/template.js"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@template-printing/types": "workspace:*",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "vitest": "1.6.0"
  }
}
